def cmd_check(app, args):
    config = app.config
    errors, warnings = [], []

    errors.extend(validate_profiles(config.profiles))

    # Warn rather than error: such a config is valid WireGuard, it just will
    # not import on a client that names the interface after the file.
    for name in sorted(config.profiles):
        problem = interface_name_problem(name)
        if problem:
            warnings.append("profile %s: %s" % (name, problem))

    for name in config.default_profiles:
        if name not in config.profiles:
            errors.append(
                "[defaults] profiles names unknown profile %r" % name)

    # registry consistency
    seen = {}
    for peer in app.registry.peers.values():
        seen.setdefault(peer.ipv4, []).append(peer.name)
        for profile_name in peer.profiles:
            if profile_name not in config.profiles:
                errors.append(
                    "peer %s uses unknown profile %r"
                    % (peer.name, profile_name))
        if config.ipv6_subnet and peer.ipv6:
            expected = str(ipv6_for_ipv4(peer.ipv4, config.ipv6_subnet))
            if peer.ipv6 != expected:
                warnings.append(
                    "peer %s has IPv6 %s, expected %s from its IPv4"
                    % (peer.name, peer.ipv6, expected)
                )
        if not app.secrets.has(peer.name, "private"):
            errors.append("peer %s has no private key on disk" % peer.name)
        if peer.has_psk and not app.secrets.has(peer.name, "psk"):
            errors.append("peer %s is marked has_psk but has no psk file"
                          % peer.name)
    for address, names in sorted(seen.items()):
        if len(names) > 1:
            errors.append("address %s used by: %s"
                          % (address, ", ".join(sorted(names))))

    # permissions
    for path in (config.secrets_dir, config.out_dir):
        if os.path.isdir(path):
            mode = stat.S_IMODE(os.stat(path).st_mode)
            if mode & 0o077:
                warnings.append("%s is mode %o, should be 700" % (path, mode))

    # environment
    for sysctl, label in (
        ("net/ipv4/ip_forward", "IPv4 forwarding"),
        ("net/ipv6/conf/all/forwarding", "IPv6 forwarding"),
    ):
        path = "/proc/sys/" + sysctl
        if config.ipv6_subnet is None and "ipv6" in sysctl:
            continue
        if os.path.exists(path):
            if read_file(path).strip() != "1":
                errors.append("%s is off (%s)" % (label, path))

    if os.path.exists(config.config_file):
        text = read_file(config.config_file)
        if re.search(r"^\s*SaveConfig\s*=\s*true", text,
                     re.MULTILINE | re.IGNORECASE):
            errors.append(
                "%s has SaveConfig = true; it will overwrite wgctl's output"
                % config.config_file
            )
        if re.search(r"^\s*Post(Up|Down)\s*=.*iptables", text, re.MULTILINE):
            warnings.append(
                "%s still has iptables PostUp/PostDown rules; ufw should own "
                "these (see MIGRATION.md)" % config.config_file
            )
        if "Generated by wgctl" not in text:
            warnings.append(
                "%s was not generated by wgctl; run `%s apply`"
                % (config.config_file, ME)
            )

    if shutil.which("ufw"):
        try:
            status = run(["ufw", "status"], check=False)
            if "Status: active" in status:
                rules = run(["ufw", "show", "added"], check=False)
                interface = config.interface
                wan = "route allow in on %s out on %s" % (
                    interface, config.wan_interface)
                if wan not in rules:
                    warnings.append(
                        "no `ufw route allow in on %s out on %s` rule found; "
                        "clients may not reach the internet"
                        % (interface, config.wan_interface)
                    )
                p2p = "route allow in on %s out on %s" % (
                    interface, interface)
                if p2p not in rules:
                    warnings.append(
                        "no `ufw route allow in on %s out on %s` rule found; "
                        "peer-to-peer traffic (including in-VPN DNS) may fail"
                        % (interface, interface)
                    )
        except Error:
            pass

    for binary in ("wg", "wg-quick"):
        if not shutil.which(binary):
            errors.append("%s is not installed" % binary)

    for line in warnings:
        print("WARN  %s" % line)
    for line in errors:
        print("ERROR %s" % line)
    if not errors and not warnings:
        print("all checks passed")
    return 1 if errors else 0


