#!/usr/bin/env python3
"""wgctl - manage WireGuard peers on a server.

Single file, standard library only, Python 3.6+.

The registry in <state_dir>/peers.json is the source of truth. The running
interface and /etc/wireguard/<iface>.conf are *derived* from it by `apply`,
which reconciles both in one idempotent step. Nothing else should edit
<iface>.conf, and SaveConfig must stay off.

Run `wgctl --help` or `wgctl <command> --help` for usage.
"""

import argparse
import configparser
import datetime
import errno
import fcntl
import ipaddress
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

VERSION = "1.0.0"
REGISTRY_VERSION = 1

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$")

# A client config's file name becomes the interface name when it is imported
# (NetworkManager, wg-quick). The kernel caps that at 15 characters and
# wg-quick rejects anything outside this character set, so a profile whose
# name breaks either rule renders a config the client refuses to import.
IFNAME_MAX = 15
IFNAME_RE = re.compile(r"^[A-Za-z0-9_=+.-]+$")

# How the user invoked us, for hint messages: "./wgctl" from a checkout,
# "wgctl" if it is on PATH. An absolute path is shortened to the basename,
# since that is what a PATH install looks like to the user.
_ARG0 = sys.argv[0]
ME = (_ARG0 if os.sep in _ARG0 and not os.path.isabs(_ARG0)
      else os.path.basename(_ARG0))

# Files/dirs that are never peers when scanning a legacy directory.
LEGACY_SKIP = {".git", ".idea", "__pycache__"}


class Error(Exception):
    """Fatal, user-facing error. Printed without a traceback."""


# --------------------------------------------------------------------------
# small helpers
# --------------------------------------------------------------------------

def now_iso():
    return datetime.datetime.now().replace(microsecond=0).isoformat()


def split_list(value):
    """Split a comma/whitespace separated config value into a clean list."""
    if not value:
        return []
    parts = re.split(r"[,\s]+", value.strip())
    return [item.strip() for item in parts if item.strip()]


def write_atomic(path, text, mode=0o600):
    """Write text to path atomically, leaving no partial file behind."""
    directory = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".wgctl-")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def ensure_dir(path, mode=0o700):
    if not os.path.isdir(path):
        os.makedirs(path, mode)
    os.chmod(path, mode)


def read_file(path):
    with open(path) as handle:
        return handle.read()


def redact(text):
    """Blank out key material so config text is safe to print in a diff."""
    return re.sub(
        r"^(\s*(?:PrivateKey|PresharedKey)\s*=\s*).*$",
        r"\1<redacted>",
        text,
        flags=re.MULTILINE,
    )


def run(argv, stdin=None, check=True):
    """Run a command, returning stdout. Python 3.6 compatible."""
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.PIPE if stdin is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
        )
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            raise Error("command not found: %s" % argv[0])
        raise
    out, err = proc.communicate(stdin)
    if check and proc.returncode != 0:
        raise Error(
            "%s failed (exit %d): %s"
            % (" ".join(argv), proc.returncode, (err or out or "").strip())
        )
    return out


# --------------------------------------------------------------------------
# config
# --------------------------------------------------------------------------

class Profile(object):
    """A named (routing, DNS) pair used to render client configs."""

    def __init__(self, name, allowed_ips, dns, description=""):
        self.name = name
        self.allowed_ips = allowed_ips  # list of str, as written in the config
        self.dns = dns                  # list of str (IP addresses)
        self.description = description

    @property
    def networks(self):
        return [ipaddress.ip_network(item, strict=False)
                for item in self.allowed_ips]


class Config(object):
    def __init__(self, path):
        self.path = path
        # Relative paths in the config file resolve against its own directory,
        # so a repo checkout is self-contained and needs no install step.
        self.base_dir = os.path.dirname(os.path.abspath(path))
        parser = configparser.ConfigParser(
            interpolation=configparser.ExtendedInterpolation()
        )
        if not parser.read([path]):
            raise Error("cannot read config file: %s" % path)
        self.parser = parser

        if not parser.has_section("server"):
            raise Error("%s has no [server] section" % path)
        server = parser["server"]

        def required(key):
            if key not in server or not server[key].strip():
                raise Error("%s: [server] %s is required" % (path, key))
            return server[key].strip()

        self.interface = server.get("interface", "wg0").strip()
        self.endpoint = required("endpoint")
        self.listen_port = int(server.get("listen_port", "51820"))
        self.wan_interface = server.get("wan_interface", "eth0").strip()

        self.ipv4_subnet = ipaddress.ip_network(required("ipv4_subnet"))
        self.ipv4_address = ipaddress.ip_address(required("ipv4_address"))
        if self.ipv4_address not in self.ipv4_subnet:
            raise Error(
                "[server] ipv4_address %s is not inside ipv4_subnet %s"
                % (self.ipv4_address, self.ipv4_subnet)
            )

        subnet6 = server.get("ipv6_subnet", "").strip()
        self.ipv6_subnet = ipaddress.ip_network(subnet6) if subnet6 else None

        # /etc/wireguard holds the server's own identity and the generated
        # interface config, because wg-quick requires them there. Everything
        # else defaults to living beside this config file.
        self.private_key_file = self._resolve(
            server.get("private_key_file", "/etc/wireguard/privatekey").strip())
        self.config_file = self._resolve(
            server.get("config_file",
                       "/etc/wireguard/%s.conf" % self.interface).strip())
        self.state_dir = self._resolve(server.get("state_dir", "state").strip())

        mtu = server.get("mtu", "").strip()
        self.mtu = int(mtu) if mtu else None
        keepalive = server.get("persistent_keepalive", "25").strip()
        self.persistent_keepalive = int(keepalive) if keepalive else None

        self.reserved = set()
        for item in split_list(server.get("reserved_addresses", "")):
            self.reserved.add(ipaddress.ip_address(item))

        self.profiles = {}
        for section in parser.sections():
            if not section.startswith("profile:"):
                continue
            name = section.split(":", 1)[1].strip()
            body = parser[section]
            self.profiles[name] = Profile(
                name,
                split_list(body.get("allowed_ips", "")),
                split_list(body.get("dns", "")),
                body.get("description", "").strip(),
            )
        if not self.profiles:
            raise Error("%s defines no [profile:NAME] sections" % path)

        defaults = split_list(
            parser["defaults"].get("profiles", "")
            if parser.has_section("defaults")
            else ""
        )
        self.default_profiles = defaults or sorted(self.profiles)

    def _resolve(self, value):
        """Absolute paths are used as given; relative ones hang off base_dir."""
        if not value or os.path.isabs(value):
            return value
        return os.path.normpath(os.path.join(self.base_dir, value))

    # derived paths -------------------------------------------------------

    @property
    def registry_file(self):
        return os.path.join(self.state_dir, "peers.json")

    @property
    def secrets_dir(self):
        return os.path.join(self.state_dir, "secrets")

    @property
    def out_dir(self):
        return os.path.join(self.state_dir, "out")

    @property
    def lock_file(self):
        return os.path.join(self.state_dir, ".lock")

    @property
    def ipv6_address(self):
        if not self.ipv6_subnet:
            return None
        return ipv6_for_ipv4(self.ipv4_address, self.ipv6_subnet)

    def profile(self, name):
        if name not in self.profiles:
            raise Error(
                "unknown profile %r (known: %s)"
                % (name, ", ".join(sorted(self.profiles)))
            )
        return self.profiles[name]


def find_config(explicit=None):
    """Prefer a config beside the script, so a checkout runs in place.

    realpath() is used so a symlink into PATH still finds the checkout.
    """
    if explicit:
        return explicit
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (
        os.environ.get("WGCTL_CONFIG"),
        os.path.join(here, "wgctl.conf"),
        os.path.join(os.getcwd(), "wgctl.conf"),
        "/etc/wgctl/wgctl.conf",
    ):
        if candidate and os.path.exists(candidate):
            return candidate
    raise Error(
        "no config file found; run this from a checkout containing "
        "wgctl.conf (cp wgctl.conf.example wgctl.conf), or pass --config"
    )


# --------------------------------------------------------------------------
# addressing (pure functions - unit tested)
# --------------------------------------------------------------------------

def ipv6_for_ipv4(v4, subnet6):
    """Map an IPv4 host onto an IPv6 host part that *reads* the same.

    10.8.0.22 -> <subnet>::22

    The last IPv4 octet is taken as a literal string and re-read as
    hexadecimal, so the text after the final colon matches the text after the
    final dot. It is not an arithmetic conversion (decimal 22 -> 0x22 -> 34),
    but it keeps addresses legible and every octet 1..254 maps to a distinct
    host part.
    """
    v4 = ipaddress.ip_address(str(v4))
    last = v4.packed[3]
    host = int(str(last), 16)
    return subnet6.network_address + host


def allocate_ipv4(subnet4, server_address, used, reserved=()):
    """Lowest free host address in subnet4, skipping server/used/reserved."""
    used = {ipaddress.ip_address(str(item)) for item in used}
    reserved = {ipaddress.ip_address(str(item)) for item in reserved}
    for host in subnet4.hosts():
        if host == server_address or host in used or host in reserved:
            continue
        return host
    raise Error("no free addresses left in %s" % subnet4)


def validate_profiles(profiles):
    """Return a list of human-readable problems with the profile definitions.

    The important check: a profile that sets DNS must route that DNS address
    through the tunnel, otherwise queries silently leave over the local link
    and the config is not doing what it appears to do.
    """
    problems = []
    for name in sorted(profiles):
        profile = profiles[name]
        if not profile.allowed_ips:
            problems.append("profile %s: allowed_ips is empty" % name)
            continue
        try:
            networks = profile.networks
        except ValueError as exc:
            problems.append("profile %s: bad allowed_ips (%s)" % (name, exc))
            continue
        for entry in profile.dns:
            try:
                address = ipaddress.ip_address(entry)
            except ValueError:
                problems.append(
                    "profile %s: DNS %r is not an IP address (search domains "
                    "are not supported)" % (name, entry)
                )
                continue
            if not any(address in net for net in networks
                       if net.version == address.version):
                problems.append(
                    "profile %s: DNS %s is not covered by allowed_ips (%s); "
                    "queries would bypass the tunnel"
                    % (name, address, ", ".join(profile.allowed_ips))
                )
    return problems


def interface_name_problem(name):
    """Why `name` cannot become an interface name, or None if it can.

    A peer's config is written as <profile>.conf and importers derive the
    interface name from that file name, so a profile name is bounded by the
    kernel's limit even though nothing in wgctl itself cares.
    """
    if len(name) > IFNAME_MAX:
        return ("name is %d characters; clients that derive an interface "
                "name from the file name (NetworkManager, wg-quick) reject "
                "more than %d" % (len(name), IFNAME_MAX))
    if not IFNAME_RE.match(name):
        return ("name has characters wg-quick does not accept in an "
                "interface name (allowed: A-Z a-z 0-9 _ = + . -)")
    return None


# --------------------------------------------------------------------------
# registry
# --------------------------------------------------------------------------

class Peer(object):
    def __init__(self, name, data):
        self.name = name
        self.public_key = data["public_key"]
        self.ipv4 = data["ipv4"]
        self.ipv6 = data.get("ipv6")
        self.profiles = list(data.get("profiles", []))
        self.enabled = bool(data.get("enabled", True))
        self.has_psk = bool(data.get("has_psk", False))
        self.created = data.get("created", "")
        self.note = data.get("note", "")

    def to_dict(self):
        return {
            "public_key": self.public_key,
            "ipv4": self.ipv4,
            "ipv6": self.ipv6,
            "profiles": self.profiles,
            "enabled": self.enabled,
            "has_psk": self.has_psk,
            "created": self.created,
            "note": self.note,
        }

    @property
    def addresses(self):
        out = ["%s/32" % self.ipv4]
        if self.ipv6:
            out.append("%s/128" % self.ipv6)
        return out


class Registry(object):
    """peers.json. Public key material only - safe to commit to git."""

    def __init__(self, config):
        self.config = config
        self.peers = {}
        self._load()

    def _load(self):
        path = self.config.registry_file
        if not os.path.exists(path):
            return
        try:
            data = json.loads(read_file(path))
        except ValueError as exc:
            raise Error("%s is not valid JSON: %s" % (path, exc))
        version = data.get("version")
        if version != REGISTRY_VERSION:
            raise Error(
                "%s has registry version %r, this wgctl expects %d"
                % (path, version, REGISTRY_VERSION)
            )
        for name, body in data.get("peers", {}).items():
            self.peers[name] = Peer(name, body)

    def save(self):
        ensure_dir(self.config.state_dir, 0o700)
        payload = {
            "version": REGISTRY_VERSION,
            "peers": {n: p.to_dict() for n, p in sorted(self.peers.items())},
        }
        write_atomic(
            self.config.registry_file,
            json.dumps(payload, indent=2, sort_keys=True) + "\n",
            0o644,
        )

    # ---------------------------------------------------------------- views

    def get(self, name):
        if name not in self.peers:
            raise Error("no such peer: %s" % name)
        return self.peers[name]

    def sorted_peers(self):
        return sorted(
            self.peers.values(), key=lambda p: ipaddress.ip_address(p.ipv4)
        )

    def enabled_peers(self):
        return [p for p in self.sorted_peers() if p.enabled]

    def used_ipv4(self):
        return [p.ipv4 for p in self.peers.values()]


# --------------------------------------------------------------------------
# secrets
# --------------------------------------------------------------------------

class Secrets(object):
    """Client private keys and preshared keys. Never commit these."""

    def __init__(self, config):
        self.config = config

    def dir_for(self, name):
        return os.path.join(self.config.secrets_dir, name)

    def path(self, name, kind):
        return os.path.join(self.dir_for(name), kind)

    def store(self, name, kind, value):
        ensure_dir(self.config.secrets_dir, 0o700)
        ensure_dir(self.dir_for(name), 0o700)
        write_atomic(self.path(name, kind), value.strip() + "\n", 0o600)

    def load(self, name, kind, required=True):
        path = self.path(name, kind)
        if not os.path.exists(path):
            if required:
                raise Error(
                    "missing %s for peer %s (expected %s)" % (kind, name, path)
                )
            return None
        return read_file(path).strip()

    def has(self, name, kind):
        return os.path.exists(self.path(name, kind))

    def discard(self, name):
        directory = self.dir_for(name)
        if os.path.isdir(directory):
            shutil.rmtree(directory)


# --------------------------------------------------------------------------
# wireguard interaction
# --------------------------------------------------------------------------

def wg_genkey():
    return run(["wg", "genkey"]).strip()


def wg_pubkey(private_key):
    return run(["wg", "pubkey"], stdin=private_key + "\n").strip()


def wg_genpsk():
    return run(["wg", "genpsk"]).strip()


def interface_is_up(interface):
    try:
        run(["wg", "show", interface, "public-key"])
        return True
    except Error:
        return False


def wg_dump(interface):
    """Parse `wg show <iface> dump` into {public_key: {...}}."""
    out = run(["wg", "show", interface, "dump"])
    peers = {}
    for index, line in enumerate(out.splitlines()):
        fields = line.split("\t")
        if index == 0:
            continue  # interface line
        if len(fields) < 8:
            continue
        peers[fields[0]] = {
            "preshared_key": fields[1],
            "endpoint": fields[2],
            "allowed_ips": fields[3],
            "latest_handshake": int(fields[4] or 0),
            "rx": int(fields[5] or 0),
            "tx": int(fields[6] or 0),
        }
    return peers


def handshake_age(timestamp):
    if not timestamp:
        return "never"
    delta = int(datetime.datetime.now().timestamp()) - timestamp
    if delta < 0:
        delta = 0
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if delta >= size:
            return "%d%s ago" % (delta // size, unit)
    return "%ds ago" % delta


# --------------------------------------------------------------------------
# rendering (pure functions - unit tested)
# --------------------------------------------------------------------------

def render_server_config(config, peers, server_private_key, psk_lookup=None):
    """Build the full contents of /etc/wireguard/<iface>.conf.

    Disabled peers are omitted entirely. SaveConfig is deliberately absent
    (it defaults to off) and there are no PostUp/PostDown rules - firewalling
    and NAT are owned by ufw. See MIGRATION.md.
    """
    addresses = ["%s/%d" % (config.ipv4_address, config.ipv4_subnet.prefixlen)]
    if config.ipv6_subnet:
        addresses.append(
            "%s/%d" % (config.ipv6_address, config.ipv6_subnet.prefixlen)
        )

    lines = [
        "# Generated by wgctl %s - do not edit by hand." % VERSION,
        "# Regenerate with: wgctl apply",
        "#",
        "# Peer list comes from the wgctl registry. SaveConfig must stay off,",
        "# and forwarding/NAT is owned by ufw, not PostUp rules.",
        "",
        "[Interface]",
        "Address = %s" % ", ".join(addresses),
        "ListenPort = %d" % config.listen_port,
        "PrivateKey = %s" % server_private_key,
    ]
    if config.mtu:
        lines.append("MTU = %d" % config.mtu)

    for peer in peers:
        lines.extend(["", "# peer: %s" % peer.name, "[Peer]"])
        lines.append("PublicKey = %s" % peer.public_key)
        psk = psk_lookup(peer.name) if (psk_lookup and peer.has_psk) else None
        if psk:
            lines.append("PresharedKey = %s" % psk)
        lines.append("AllowedIPs = %s" % ", ".join(peer.addresses))

    return "\n".join(lines) + "\n"


def render_client_config(config, peer, profile, private_key,
                         server_public_key, psk=None):
    """Build one client .conf for a peer/profile pair."""
    lines = [
        "# %s - profile %s (generated by wgctl %s)"
        % (peer.name, profile.name, VERSION),
    ]
    if profile.description:
        lines.append("# %s" % profile.description)
    lines.extend([
        "",
        "[Interface]",
        "Address = %s" % ", ".join(peer.addresses),
        "PrivateKey = %s" % private_key,
    ])
    if profile.dns:
        lines.append("DNS = %s" % ", ".join(profile.dns))
    if config.mtu:
        lines.append("MTU = %d" % config.mtu)

    lines.extend([
        "",
        "[Peer]",
        "PublicKey = %s" % server_public_key,
    ])
    if psk:
        lines.append("PresharedKey = %s" % psk)
    lines.append("Endpoint = %s:%d" % (config.endpoint, config.listen_port))
    lines.append("AllowedIPs = %s" % ", ".join(profile.allowed_ips))
    if config.persistent_keepalive:
        lines.append("PersistentKeepalive = %d" % config.persistent_keepalive)

    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------
# application object
# --------------------------------------------------------------------------

class App(object):
    def __init__(self, config):
        self.config = config
        self.secrets = Secrets(config)
        self.registry = Registry(config)
        self._lock_handle = None

    # -------------------------------------------------------------- locking

    def lock(self):
        """Serialise mutating commands so two runs cannot race the registry."""
        try:
            ensure_dir(self.config.state_dir, 0o700)
        except OSError as exc:
            raise Error(
                "cannot create state dir %s (%s). Run with sudo?"
                % (self.config.state_dir, exc.strerror)
            )
        self._lock_handle = open(self.config.lock_file, "w")
        try:
            fcntl.flock(self._lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except IOError:
            raise Error(
                "another wgctl is running (lock: %s)" % self.config.lock_file)
        # The registry was read before the lock existed; re-read it now that we
        # hold it, so a concurrent run's writes cannot be clobbered.
        self.registry = Registry(self.config)

    # ---------------------------------------------------------- server keys

    def server_private_key(self):
        path = self.config.private_key_file
        if not os.path.exists(path):
            raise Error(
                "server private key not found at %s. Create one with:\n"
                "  umask 077 && wg genkey > %s" % (path, path)
            )
        key = read_file(path).strip()
        if not key:
            raise Error("%s is empty" % path)
        return key

    def server_public_key(self):
        return wg_pubkey(self.server_private_key())

    # ------------------------------------------------------------ rendering

    def render_peer(self, peer, quiet=False):
        """Write every profile config for one peer. No rekeying."""
        private_key = self.secrets.load(peer.name, "private")
        psk = self.secrets.load(peer.name, "psk", required=False)
        server_public = self.server_public_key()

        directory = os.path.join(self.config.out_dir, peer.name)
        ensure_dir(self.config.out_dir, 0o700)
        ensure_dir(directory, 0o700)

        written = []
        for profile_name in peer.profiles:
            profile = self.config.profile(profile_name)
            text = render_client_config(
                self.config, peer, profile, private_key, server_public, psk
            )
            # Named for the profile alone: the peer's name is already the
            # directory, and importers derive an interface name from the
            # file name, which the kernel caps at IFNAME_MAX characters.
            path = os.path.join(directory, "%s.conf" % profile_name)
            write_atomic(path, text, 0o600)
            written.append(path)

        # Drop configs this peer no longer has a profile for, including the
        # <peer>-<profile>.conf names written before that rename. Everything
        # in here is regenerated from the stored keys, so nothing is lost.
        keep = set(os.path.basename(path) for path in written)
        stale = [entry for entry in sorted(os.listdir(directory))
                 if entry.endswith(".conf") and entry not in keep]
        for entry in stale:
            os.remove(os.path.join(directory, entry))

        if not quiet:
            print("rendered %d config(s) for %s in %s"
                  % (len(written), peer.name, directory))
            if stale:
                print("removed %d stale config(s): %s"
                      % (len(stale), ", ".join(stale)))
        return written

    # --------------------------------------------------------------- apply

    def build_server_config(self):
        return render_server_config(
            self.config,
            self.registry.enabled_peers(),
            self.server_private_key(),
            lambda name: self.secrets.load(name, "psk", required=False),
        )

    def apply(self, dry_run=False):
        new_text = self.build_server_config()
        path = self.config.config_file
        old_text = read_file(path) if os.path.exists(path) else ""

        self._print_peer_diff(old_text, new_text)

        if old_text == new_text:
            print("%s is already up to date." % path)
        elif dry_run:
            import difflib
            diff = difflib.unified_diff(
                redact(old_text).splitlines(),
                redact(new_text).splitlines(),
                fromfile="%s (current)" % path,
                tofile="%s (new)" % path,
                lineterm="",
            )
            body = "\n".join(diff)
            print(body if body else "(no textual change)")
        else:
            if old_text:
                backup = "%s.bak-%s" % (
                    path, datetime.datetime.now().strftime("%Y%m%d%H%M%S")
                )
                write_atomic(backup, old_text, 0o600)
                print("backed up %s -> %s" % (path, backup))
            write_atomic(path, new_text, 0o600)
            print("wrote %s" % path)

        if dry_run:
            print("\n(dry run: the interface was not touched)")
            return

        interface = self.config.interface
        if not interface_is_up(interface):
            print(
                "interface %s is not up; config written but not loaded.\n"
                "  start it with: systemctl start wg-quick@%s"
                % (interface, interface)
            )
            return

        stripped = run(["wg-quick", "strip", interface])
        ensure_dir(self.config.state_dir, 0o700)
        tmp = os.path.join(self.config.state_dir, ".syncconf")
        write_atomic(tmp, stripped, 0o600)
        try:
            run(["wg", "syncconf", interface, tmp])
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        print("reloaded %s (existing sessions preserved; any drift between "
              "the file and live state is corrected)" % interface)

    def _print_peer_diff(self, old_text, new_text):
        """Report which peers apply would add or remove, by public key."""
        def keys(text):
            found = {}
            name = None
            for line in text.splitlines():
                match = re.match(r"^#\s*peer:\s*(\S+)", line)
                if match:
                    name = match.group(1)
                    continue
                match = re.match(r"^PublicKey\s*=\s*(\S+)", line)
                if match:
                    found[match.group(1)] = name or "?"
                    name = None
            return found

        before, after = keys(old_text), keys(new_text)
        added = {after[k] for k in after if k not in before}
        removed = {before[k] for k in before if k not in after}
        # A name in both lists kept its slot but changed key: a rotation.
        rekeyed = added & removed
        added -= rekeyed
        removed -= rekeyed
        for label, names in (
            ("peers to add", added),
            ("peers to remove", removed),
            ("peers with a new key", rekeyed),
        ):
            if names:
                print("%-21s %s" % (label + ":", ", ".join(sorted(names))))
        if not added and not removed and not rekeyed:
            print("peer set unchanged (%d enabled)" % len(after))


