def _parse_legacy_peer(directory):
    """Read one legacy mkconfig.sh peer directory.

    Returns (public_key, private_key, ipv4) or None if it is not a peer dir.
    """
    public_path = os.path.join(directory, "public")
    if not os.path.isfile(public_path):
        return None
    public_key = read_file(public_path).strip()
    if not public_key:
        return None

    private_path = os.path.join(directory, "private")
    private_key = None
    if os.path.isfile(private_path):
        private_key = read_file(private_path).strip()

    address = None
    server_conf = os.path.join(directory, "server.conf")
    if os.path.isfile(server_conf):
        match = re.search(
            r"^AllowedIPs\s*=\s*([0-9.]+)",
            read_file(server_conf),
            re.MULTILINE,
        )
        if match:
            address = match.group(1)
    if not address:
        # fall back to the client config's Address line
        for entry in sorted(os.listdir(directory)):
            if not entry.endswith(".conf") or entry == "server.conf":
                continue
            match = re.search(
                r"^Address\s*=\s*([0-9.]+)",
                read_file(os.path.join(directory, entry)),
                re.MULTILINE,
            )
            if match:
                address = match.group(1)
                break
    return {"public_key": public_key, "private_key": private_key,
            "ipv4": address}


def cmd_import(app, args):
    source = os.path.abspath(args.source)
    if not os.path.isdir(source):
        raise Error("not a directory: %s" % source)

    config = app.config
    found, problems = {}, []
    for entry in sorted(os.listdir(source)):
        if entry in LEGACY_SKIP or entry.startswith("."):
            continue
        directory = os.path.join(source, entry)
        if not os.path.isdir(directory):
            continue
        parsed = _parse_legacy_peer(directory)
        if parsed is None:
            continue
        name = entry
        if not NAME_RE.match(name):
            problems.append("%s: name is not usable as a peer name" % name)
            continue
        if not parsed["ipv4"]:
            problems.append("%s: could not determine an IPv4 address" % name)
            continue
        if not parsed["private_key"]:
            problems.append(
                "%s: no private key on disk; it must be rotated after import"
                % name
            )
        try:
            address = ipaddress.ip_address(parsed["ipv4"])
        except ValueError:
            problems.append("%s: bad address %r" % (name, parsed["ipv4"]))
            continue
        if address not in config.ipv4_subnet:
            problems.append(
                "%s: %s is outside %s" % (name, address, config.ipv4_subnet)
            )
            continue
        parsed["ipv4"] = str(address)
        found[name] = parsed

    # collisions
    by_address = {}
    for name, parsed in found.items():
        by_address.setdefault(parsed["ipv4"], []).append(name)
    for address, names in sorted(by_address.items()):
        if len(names) > 1:
            problems.append(
                "address %s is claimed by several peers: %s"
                % (address, ", ".join(sorted(names)))
            )

    live = {}
    try:
        live = wg_dump(config.interface)
    except Error:
        print("note: could not read live interface state (%s)\n"
              % config.interface)

    print("Found %d peer directory(ies) under %s\n" % (len(found), source))
    header = ("NAME", "IPV4", "IPV6", "PRIVKEY", "LIVE", "HANDSHAKE")
    rows = []
    def by_address(name):
        return ipaddress.ip_address(found[name]["ipv4"])

    for name in sorted(found, key=by_address):
        parsed = found[name]
        address6 = (
            ipv6_for_ipv4(parsed["ipv4"], config.ipv6_subnet)
            if config.ipv6_subnet else None
        )
        info = live.get(parsed["public_key"])
        rows.append((
            name,
            parsed["ipv4"],
            str(address6) if address6 else "-",
            "yes" if parsed["private_key"] else "MISSING",
            "yes" if info else ("no" if live else "?"),
            handshake_age(info["latest_handshake"]) if info else "-",
        ))
    if rows:
        widths = [max(len(str(r[i])) for r in [header] + rows)
                  for i in range(len(header))]
        fmt = "  ".join("%%-%ds" % w for w in widths)
        print(fmt % header)
        for row in rows:
            print(fmt % row)

    known_keys = {p["public_key"] for p in found.values()}
    orphans = sorted(set(live) - known_keys)
    if orphans:
        print("\n%d peer(s) live on %s with no directory here:"
              % (len(orphans), config.interface))
        for key in orphans:
            print("  %s  %s  last handshake %s"
                  % (key, live[key]["allowed_ips"],
                     handshake_age(live[key]["latest_handshake"])))
        print("  These would be dropped by `%s apply`. Add them by hand "
              "if they matter." % ME)

    if live:
        by_key = {p["public_key"]: name for name, p in found.items()}
        missing = sorted(by_key[k] for k in known_keys - set(live))
        if missing:
            print("\n%d directory peer(s) are not loaded on %s (harmless if "
                  "they were removed earlier): %s"
                  % (len(missing), config.interface, ", ".join(missing)))

    if problems:
        print("\nProblems:")
        for problem in problems:
            print("  - %s" % problem)

    if not args.write:
        print("\n(dry run) re-run with --write to create the registry")
        return

    if problems and not args.force:
        raise Error("refusing to write with the problems above; fix them "
                    "or pass --force")

    app.lock()
    for name, parsed in found.items():
        if name in app.registry.peers and not args.force:
            print("skipping %s: already in registry" % name)
            continue
        if not parsed["private_key"]:
            print("skipping %s: no private key" % name)
            continue
        address6 = (
            ipv6_for_ipv4(parsed["ipv4"], config.ipv6_subnet)
            if config.ipv6_subnet else None
        )
        peer = Peer(name, {
            "public_key": parsed["public_key"],
            "ipv4": parsed["ipv4"],
            "ipv6": str(address6) if address6 else None,
            "profiles": list(config.default_profiles),
            "enabled": True,
            "has_psk": False,
            "created": now_iso(),
            "note": "imported from %s" % source,
        })
        app.secrets.store(name, "private", parsed["private_key"])
        app.registry.peers[name] = peer
    app.registry.save()
    print("\nwrote %s with %d peer(s)"
          % (config.registry_file, len(app.registry.peers)))
    print("next: `%s render --all`, review, then `%s apply --dry-run`"
          % (ME, ME))


