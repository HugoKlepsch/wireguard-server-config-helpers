def check_name(name):
    if not NAME_RE.match(name):
        raise Error(
            "invalid peer name %r: use letters, digits, dot, dash, "
            "underscore; must start alphanumeric" % name
        )
    return name


def cmd_add(app, args):
    app.lock()
    name = check_name(args.name)
    if name in app.registry.peers:
        raise Error("peer %s already exists (use `rotate` to rekey it)" % name)

    config = app.config
    if args.address:
        address = ipaddress.ip_address(args.address)
        if address not in config.ipv4_subnet:
            raise Error("%s is not inside %s" % (address, config.ipv4_subnet))
        if str(address) in app.registry.used_ipv4():
            raise Error("%s is already assigned" % address)
        if address == config.ipv4_address:
            raise Error("%s is the server's own address" % address)
    else:
        address = allocate_ipv4(
            config.ipv4_subnet,
            config.ipv4_address,
            app.registry.used_ipv4(),
            config.reserved,
        )

    profiles = args.profile or config.default_profiles
    for profile_name in profiles:
        config.profile(profile_name)  # validate before generating keys

    private_key = wg_genkey()
    public_key = wg_pubkey(private_key)
    psk = None if args.no_psk else wg_genpsk()

    address6 = (ipv6_for_ipv4(address, config.ipv6_subnet)
                if config.ipv6_subnet else None)
    peer = Peer(name, {
        "public_key": public_key,
        "ipv4": str(address),
        "ipv6": str(address6) if address6 else None,
        "profiles": list(profiles),
        "enabled": True,
        "has_psk": psk is not None,
        "created": now_iso(),
        "note": args.note or "",
    })

    app.secrets.store(name, "private", private_key)
    if psk:
        app.secrets.store(name, "psk", psk)
    app.registry.peers[name] = peer
    app.registry.save()

    print("added %s at %s%s" % (
        name, address, " / %s" % address6 if address6 else ""
    ))
    app.render_peer(peer)
    if args.apply:
        print("")
        app.apply()
    else:
        print("run `%s apply` to load this peer onto the server" % ME)


def cmd_list(app, args):
    peers = app.registry.sorted_peers()
    if not peers:
        print("no peers in registry")
        return

    live = {}
    if not args.no_live:
        try:
            live = wg_dump(app.config.interface)
        except Error:
            pass  # interface down or wg unavailable; addresses still listed

    header = ("NAME", "IPV4", "IPV6", "STATE", "PSK", "HANDSHAKE", "PROFILES")
    rows = []
    for peer in peers:
        info = live.get(peer.public_key)
        rows.append((
            peer.name,
            peer.ipv4,
            peer.ipv6 or "-",
            "enabled" if peer.enabled else "DISABLED",
            "yes" if peer.has_psk else "no",
            handshake_age(info["latest_handshake"]) if info else
            ("-" if not live else "not loaded"),
            ",".join(peer.profiles),
        ))

    widths = [
        max(len(str(row[i])) for row in [header] + rows)
        for i in range(len(header))
    ]
    fmt = "  ".join("%%-%ds" % w for w in widths)
    print(fmt % header)
    for row in rows:
        print(fmt % row)

    if live:
        unknown = set(live) - {p.public_key for p in peers}
        if unknown:
            print("\nWARNING: %d peer(s) on the interface are not in the "
                  "registry:" % len(unknown))
            for key in sorted(unknown):
                print("  %s  last handshake %s"
                      % (key, handshake_age(live[key]["latest_handshake"])))
            print("  `%s apply` would remove them." % ME)


def cmd_show(app, args):
    peer = app.registry.get(args.name)
    if args.profile:
        profiles = [args.profile]
    else:
        profiles = peer.profiles
    private_key = app.secrets.load(peer.name, "private")
    psk = app.secrets.load(peer.name, "psk", required=False)
    server_public = app.server_public_key()
    for index, profile_name in enumerate(profiles):
        profile = app.config.profile(profile_name)
        if index:
            print("")
        print(render_client_config(
            app.config, peer, profile, private_key, server_public, psk
        ), end="")


def cmd_qr(app, args):
    if not shutil.which("qrencode"):
        raise Error("qrencode is not installed (apt install qrencode)")
    peer = app.registry.get(args.name)
    profile = app.config.profile(args.profile)
    text = render_client_config(
        app.config, peer, profile,
        app.secrets.load(peer.name, "private"),
        app.server_public_key(),
        app.secrets.load(peer.name, "psk", required=False),
    )
    sys.stdout.write(run(["qrencode", "-t", "ansiutf8"], stdin=text))


def cmd_render(app, args):
    app.lock()
    if args.all:
        peers = app.registry.sorted_peers()
    elif args.name:
        peers = [app.registry.get(args.name)]
    else:
        raise Error("give a peer name or --all")
    for peer in peers:
        if args.profile:
            for profile_name in args.profile:
                app.config.profile(profile_name)
            peer.profiles = list(args.profile)
        app.render_peer(peer)
    if args.profile:
        app.registry.save()


def cmd_rotate(app, args):
    app.lock()
    peer = app.registry.get(args.name)
    private_key = wg_genkey()
    peer.public_key = wg_pubkey(private_key)
    app.secrets.store(peer.name, "private", private_key)
    if args.no_psk:
        psk_path = app.secrets.path(peer.name, "psk")
        if os.path.exists(psk_path):
            os.unlink(psk_path)
        peer.has_psk = False
    else:
        app.secrets.store(peer.name, "psk", wg_genpsk())
        peer.has_psk = True
    app.registry.save()
    print("rotated keys for %s (address %s unchanged)"
          % (peer.name, peer.ipv4))
    app.render_peer(peer)
    print("the old config stops working as soon as you apply")
    if args.apply:
        print("")
        app.apply()


def _set_enabled(app, args, enabled):
    app.lock()
    peer = app.registry.get(args.name)
    peer.enabled = enabled
    app.registry.save()
    print("%s is now %s" % (peer.name, "enabled" if enabled else "disabled"))
    if args.apply:
        print("")
        app.apply()
    else:
        print("run `%s apply` to make it take effect" % ME)


def cmd_enable(app, args):
    _set_enabled(app, args, True)


def cmd_disable(app, args):
    _set_enabled(app, args, False)


def cmd_rm(app, args):
    app.lock()
    peer = app.registry.get(args.name)
    if not args.yes:
        try:
            answer = input("remove peer %s (%s) and its keys? [y/N] "
                           % (peer.name, peer.ipv4))
        except EOFError:
            raise Error("no terminal to confirm on; pass --yes")
        if answer.strip().lower() not in ("y", "yes"):
            print("aborted")
            return
    del app.registry.peers[peer.name]
    app.registry.save()

    out = os.path.join(app.config.out_dir, peer.name)
    if args.keep_secrets:
        print("kept key material in %s" % app.secrets.dir_for(peer.name))
    else:
        app.secrets.discard(peer.name)
        if os.path.isdir(out):
            shutil.rmtree(out)
    print("removed %s from the registry" % peer.name)
    if args.apply:
        print("")
        app.apply()
    else:
        print("run `%s apply` to remove it from the server" % ME)


def cmd_apply(app, args):
    if not args.dry_run:
        app.lock()
    app.apply(dry_run=args.dry_run)


