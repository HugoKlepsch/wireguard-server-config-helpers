def build_parser():
    parser = argparse.ArgumentParser(
        prog="wgctl",
        description="Manage WireGuard peers from a declarative registry.",
        epilog="The registry is the source of truth; `apply` reconciles the "
               "server to it.",
    )
    parser.add_argument("--config", help="path to wgctl.conf")
    parser.add_argument("--version", action="version",
                        version="wgctl %s" % VERSION)
    subparsers = parser.add_subparsers(dest="command")

    def add_apply_flag(sub):
        sub.add_argument("--apply", action="store_true",
                         help="run `apply` immediately afterwards")

    sub = subparsers.add_parser(
        "add", help="create a peer (does not touch the server)")
    sub.add_argument("name")
    sub.add_argument("--address", help="force an IPv4 address instead of "
                                       "allocating the lowest free one")
    sub.add_argument("--profile", action="append",
                     help="profile to render (repeatable; default: all in "
                          "[defaults])")
    sub.add_argument("--no-psk", action="store_true",
                     help="do not generate a preshared key")
    sub.add_argument("--note", help="free-text note stored in the registry")
    add_apply_flag(sub)
    sub.set_defaults(func=cmd_add)

    sub = subparsers.add_parser("list", help="list peers and live status")
    sub.add_argument("--no-live", action="store_true",
                     help="skip querying the interface")
    sub.set_defaults(func=cmd_list)

    sub = subparsers.add_parser("show", help="print a peer's config to stdout")
    sub.add_argument("name")
    sub.add_argument("profile", nargs="?",
                     help="single profile to print (default: all)")
    sub.set_defaults(func=cmd_show)

    sub = subparsers.add_parser("qr", help="print a config as a QR code")
    sub.add_argument("name")
    sub.add_argument("profile")
    sub.set_defaults(func=cmd_qr)

    sub = subparsers.add_parser(
        "render", help="rewrite client configs from stored keys (no rekey)")
    sub.add_argument("name", nargs="?")
    sub.add_argument("--all", action="store_true", help="every peer")
    sub.add_argument("--profile", action="append",
                     help="replace the peer's profile list with these")
    sub.set_defaults(func=cmd_render)

    sub = subparsers.add_parser(
        "rotate", help="issue a new keypair for a peer, keeping its address")
    sub.add_argument("name")
    sub.add_argument("--no-psk", action="store_true")
    add_apply_flag(sub)
    sub.set_defaults(func=cmd_rotate)

    sub = subparsers.add_parser(
        "disable", help="keep the peer but drop it from the server")
    sub.add_argument("name")
    add_apply_flag(sub)
    sub.set_defaults(func=cmd_disable)

    sub = subparsers.add_parser("enable", help="undo `disable`")
    sub.add_argument("name")
    add_apply_flag(sub)
    sub.set_defaults(func=cmd_enable)

    sub = subparsers.add_parser("rm", help="delete a peer from the registry")
    sub.add_argument("name")
    sub.add_argument("--keep-secrets", action="store_true",
                     help="leave key material on disk")
    sub.add_argument("-y", "--yes", action="store_true",
                     help="do not prompt")
    add_apply_flag(sub)
    sub.set_defaults(func=cmd_rm)

    sub = subparsers.add_parser(
        "apply", help="reconcile the server with the registry")
    sub.add_argument("-n", "--dry-run", action="store_true",
                     help="show what would change and exit")
    sub.set_defaults(func=cmd_apply)

    sub = subparsers.add_parser(
        "import",
        help="build the registry from legacy mkconfig.sh directories")
    sub.add_argument("source", help="directory containing per-peer subdirs")
    sub.add_argument("--write", action="store_true",
                     help="actually write the registry (default: dry run)")
    sub.add_argument("--force", action="store_true",
                     help="write despite problems / overwrite existing peers")
    sub.set_defaults(func=cmd_import)

    sub = subparsers.add_parser(
        "check", help="validate config, registry, and server environment")
    sub.set_defaults(func=cmd_check)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    try:
        config = Config(find_config(args.config))
        problems = validate_profiles(config.profiles)
        if problems and args.func is not cmd_check:
            raise Error(
                "profile definitions are invalid:\n  %s\nrun `%s check`"
                % ("\n  ".join(problems), ME)
            )
        app = App(config)
        return args.func(app, args) or 0
    except Error as exc:
        sys.stderr.write("wgctl: %s\n" % exc)
        return 1
    except ValueError as exc:
        # bad address/subnet/port in the config file
        sys.stderr.write("wgctl: invalid value in configuration: %s\n" % exc)
        return 1
    except (IOError, OSError) as exc:
        message = "wgctl: %s: %s" % (getattr(exc, "filename", "") or "error",
                                     exc.strerror or exc)
        if exc.errno in (errno.EACCES, errno.EPERM):
            message += "\n       this command needs root; try sudo"
        sys.stderr.write(message + "\n")
        return 1
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted\n")
        return 130


if __name__ == "__main__":
    sys.exit(main())
